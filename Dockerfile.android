FROM eclipse-temurin:17-jdk

# Install dependencies
RUN apt-get update && apt-get install -y \
    unzip \
    wget \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Android SDK environment
ENV ANDROID_HOME=/opt/android-sdk
ENV PATH=${PATH}:${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools
ENV JAVA_HOME=/usr/local/lib/jvm/temurin-17-jdk-amd64

# Install Android SDK
RUN mkdir -p ${ANDROID_HOME} && \
    wget -q https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip -O /tmp/cmdtools.zip && \
    unzip -q /tmp/cmdtools.zip -d ${ANDROID_HOME}/ && \
    mv ${ANDROID_HOME}/cmdline-tools latest && \
    rm /tmp/cmdtools.zip && \
    yes | sdkmanager --licenses >/dev/null 2>&1 && \
    sdkmanager "platforms;android-34" "build-tools;34.0.0"

WORKDIR /app

COPY . .
COPY android /app/android

# Build APK
RUN ./node_modules/.bin/capacitor sync android && \
    cd android && \
    ./gradlew assembleDebug && \
    mkdir -p ../release && \
    cp app/build/outputs/apk/debug/app-debug.apk ../release/

CMD ["ls", "-lah", "/app/release"]
